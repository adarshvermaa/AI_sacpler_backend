# ==============================================================================
# ALPHASCALPER BACKEND CONFIGURATION TEMPLATE
# Copy this file to .env and insert your authentic credentials.
# NEVER COMMIT YOUR REAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# Execution Mode: "PAPER" (Safe simulated execution) or "LIVE" (Real exchange execution)
TRADING_MODE=PAPER

# Account Base Margin Currency: "INR" (CoinDCX INR margin) or "USDT" (Standard USDT)
MARGIN_CURRENCY=INR

# Initial Simulation Balance (Used only when TRADING_MODE=PAPER)
INITIAL_SIMULATION_BALANCE=500.0

# ------------------------------------------------------------------------------
# COINDCX API CREDENTIALS (Required for LIVE execution & balance sync)
# ------------------------------------------------------------------------------
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# CoinDCX API Endpoints
COINDCX_REST_BASE_URL=https://api.coindcx.com
COINDCX_PUBLIC_REST_URL=https://public.coindcx.com

# ------------------------------------------------------------------------------
# NEON CLOUD POSTGRESQL CONFIGURATION (Optional - falls back to SQLite WAL)
# ------------------------------------------------------------------------------
ENABLE_NEON_CLOUD=True
NEON_DATABASE_URL=postgresql://neondb_owner:your_password@your_endpoint.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# TRADING ENGINE & WIN-WIN SCALPING PARAMETERS
# ------------------------------------------------------------------------------
DEFAULT_LEVERAGE=15.0
MAX_LEVERAGE=25.0

# Tier 1 Take Profit Ratio (+0.85% = 0.0085)
TP1_RATIO=0.0085

# Tier 2 Runner Take Profit Ratio (+1.85% = 0.0185)
TP2_RATIO=0.0185

# Hard Stop Loss Ratio (-0.45% = 0.0045)
HARD_SL_RATIO=0.0045

# Breakeven Fee Buffer (+0.08% = 0.0008)
FEE_BUFFER=0.0008

# ------------------------------------------------------------------------------
# INSTITUTIONAL RISK MANAGEMENT GUARDS
# ------------------------------------------------------------------------------
# Maximum 24-Hour Portfolio Drawdown before Circuit Breaker Trips (-4.0% = 0.04)
DAILY_LOSS_LIMIT_PCT=0.04

# Maximum Margin Allocation Cap per Single Trade (20% of Wallet = 0.20)
MAX_WALLET_MARGIN_PERCENT=0.20

# Safety Reserve Percentage (Retained in wallet, never allocated to trades)
SAFETY_RESERVE_PERCENT=0.15

# Maximum Concurrent Open Trades
MAX_ACTIVE_TRADES=5

# Minimum Confidence Score Required to Execute (0.0 to 100.0)
MIN_CONFIDENCE_THRESHOLD=62.0

# Universe Scanner Settings
UNIVERSE_MAX_ASSETS=100
TOP_RANKED_TARGETS=10
